# Supabase project settings > API. The publishable key is safe in the browser;
# row level security protects the data. Never put a secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public URL of this deployment, used for auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
