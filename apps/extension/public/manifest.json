{
  "manifest_version": 3,
  "name": "Speed Read It",
  "version": "0.1.0",
  "description": "Speed read pasted text, files, selections or whole pages one word at a time.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Open Speed Read It",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "storage", "contextMenus", "activeTab", "scripting"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+R" }
    }
  }
}
